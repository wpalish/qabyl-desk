      "css": ".ds-primary-wrap{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:16px;line-height:1.55;color:var(--ink,#172e45);}.ds-primary{min-height:44px;border:1px solid var(--navy,#183e60);border-radius:7px;background:var(--surface,#fff);color:var(--navy,#183e60);padding:.65rem 1rem;font:inherit;font-weight:650;cursor:pointer;line-height:1.35;text-align:center;}.ds-primary:hover{background:var(--nav,#dce9f3)}.ds-primary:focus-visible{outline:3px solid var(--focus,#bd671a);outline-offset:3px}.ds-primary:disabled{opacity:.6;cursor:default}.ds-primary{color:var(--surface,#fff);background:var(--primary,#126653);border-color:var(--primary,#126653)}.ds-primary:hover{background:var(--hover,#0b5343)}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color .15s ease-out,color .15s ease-out}}"
