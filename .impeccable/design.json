      "description": "Visible label and native full-width input; no runtime required.",
      "html": "<div class=\"ds-field-wrap\"><label class=\"ds-label\" for=\"ds-packet-title\">Название черновика</label><input class=\"ds-input\" id=\"ds-packet-title\" value=\"Учебный пакет\" maxlength=\"200\"></div>",
      "css": ".ds-field-wrap{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:16px;line-height:1.55;color:var(--ink,#172e45);}.ds-label{display:block;font-weight:650;margin-bottom:.35rem;}.ds-input{display:block;width:100%;max-width:100%;border:1px solid var(--input,#7894aa);border-radius:7px;padding:.7rem;background:var(--surface,#fff);color:var(--ink,#172e45);min-height:44px;font:inherit;caret-color:var(--navy,#183e60);}.ds-input:focus-visible{outline:3px solid var(--focus,#bd671a);outline-offset:3px}"
